# Public by design: this value ships in the browser bundle and is not a secret.
# Create it in Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID → Web application, and add this site's origin (for example
# http://localhost:3000) under "Authorized JavaScript origins". The same client
# powers Google sign-in and Drive sync. See docs/GOOGLE-DRIVE.md.
#
# Leave empty to keep PenPaper local-only: the app stays fully usable, accounts
# turn off, and the shelf explains that Drive is not configured.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server-only. Neon Postgres for accounts, board snapshots, and share links.
# Create a free project at neon.tech (no card) and paste its pooled connection
# string. Leave empty to keep accounts and sharing switched off: the app still
# opens every local notepad. Accounts also need the Google client id above.
DATABASE_URL=

# Server-only. At least 32 random bytes, for example
# `openssl rand -hex 32`. Signs the five-minute collab token the socket service
# verifies. Session cookies are separate random tokens stored hashed in
# Postgres, so this secret is not what keeps a session valid. Rotating it signs
# nobody out, but invalidates in-flight room tokens.
PENPAPER_SECRET=

# Server-only, optional. Redis turns three per-process behaviours into shared
# ones: the rate-limit window, the session cache, and the live rooms (Socket.IO
# adapter plus a per-room update log). Leave it empty and every one of those
# falls back to working exactly as it does on the single free instance.
# `docker compose up -d redis` serves this URL locally.
REDIS_URL=

# Server-only, optional. Apache Kafka holds the board event log: created, saved,
# shared, opened, removed. The API produces, and a separate worker consumes into
# `pp_board_events`, which backs the activity line in the board menu. With this
# empty there is no producer and no log, and no route fails because of it.
# Local broker: `docker compose up -d kafka`. Comma-separate several brokers.
KAFKA_BROKERS=

# Optional. Topic name for board events; both the API and the worker read it, so
# they agree by default. Only change it if something else owns the default name.
KAFKA_TOPIC=
