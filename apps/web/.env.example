# Public by design: this value ships in the browser bundle and is not a secret.
# Create it in Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID → Web application. See docs/GOOGLE-DRIVE.md.
#
# Leave empty to keep PenPaper local-only: the app stays fully usable and the
# shelf explains that Drive is not configured.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server-only. Neon Postgres for accounts, board snapshots, and share links.
# Create a free project at neon.tech (no card) and paste its pooled connection
# string. Leave empty to keep accounts and sharing switched off: the app still
# opens every local notepad.
DATABASE_URL=

# Server-only. At least 32 random bytes, for example
# `openssl rand -hex 32`. Signs the five-minute collab token the socket service
# verifies. Session cookies are separate random tokens stored hashed in
# Postgres, so this secret is not what keeps a session valid. Rotating it signs
# nobody out, but invalidates in-flight room tokens.
PENPAPER_SECRET=
